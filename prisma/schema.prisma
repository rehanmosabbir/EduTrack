generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  STUDENT
  GUARDIAN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

enum HomeworkAssignmentStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum PreparationStatus {
  PREPARED
  PARTIALLY_PREPARED
  NOT_PREPARED
}

enum HomeworkCompletionStatus {
  COMPLETED
  PARTIALLY_COMPLETED
  NOT_COMPLETED
}

enum NotificationType {
  HOMEWORK_ASSIGNED
  HOMEWORK_DUE_SOON
  EVALUATION_RECORDED
  GUARDIAN_COMMENT
  TEACHER_REPLY
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String?
  image        String?
  role         Role
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student              Student?
  guardian             Guardian?
  homeworkCreated      HomeworkAssignment[] @relation("HomeworkCreatedBy")
  evaluationsGiven     LessonEvaluation[]   @relation("EvaluatedBy")
  auditLogs            AuditLog[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference?

  @@index([role])
  @@index([status])
}

model Student {
  id             String          @id @default(cuid())
  userId         String?         @unique
  studentCode    String          @unique
  fullName       String
  photoUrl       String?
  className      String
  schoolName     String?
  enrollmentDate DateTime        @db.Date
  phone          String?
  status         AccountStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  guardians          StudentGuardian[]
  subjects           StudentSubject[]
  homeworkAssignments HomeworkAssignment[]
  evaluations        LessonEvaluation[]
  comments           GuardianComment[]

  @@index([className])
  @@index([status])
  @@index([fullName])
}

model Guardian {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentGuardian[]
  comments GuardianComment[]
}

model StudentGuardian {
  id           String   @id @default(cuid())
  studentId    String
  guardianId   String
  relationship String   @default("Parent")
  createdAt    DateTime @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([guardianId])
  @@index([studentId])
}

model Subject {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      SubjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  students            StudentSubject[]
  homeworkAssignments HomeworkAssignment[]
  evaluations         LessonEvaluation[]

  @@unique([name])
  @@index([status])
}

model StudentSubject {
  id        String           @id @default(cuid())
  studentId String
  subjectId String
  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([studentId, subjectId])
  @@index([subjectId])
  @@index([status])
}

model HomeworkAssignment {
  id                 String                   @id @default(cuid())
  studentId          String
  subjectId          String
  title              String
  lessonOrChapter    String
  instructions       String
  assignedAt         DateTime                 @db.Date
  dueDate            DateTime?                @db.Date
  maximumMarks       Float?
  attachmentUrl      String?
  teacherNotes       String?
  status             HomeworkAssignmentStatus @default(ACTIVE)
  createdByTeacherId String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  student          Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subject          Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdByTeacher User               @relation("HomeworkCreatedBy", fields: [createdByTeacherId], references: [id], onDelete: Restrict)
  evaluations      LessonEvaluation[]
  comments         GuardianComment[]

  @@index([studentId])
  @@index([subjectId])
  @@index([assignedAt])
  @@index([dueDate])
  @@index([status])
  @@index([studentId, assignedAt])
}

model LessonEvaluation {
  id                   String                    @id @default(cuid())
  studentId            String
  subjectId            String
  homeworkAssignmentId String?
  evaluationDate       DateTime                  @db.Date
  lessonOrChapter      String
  preparationStatus    PreparationStatus
  homeworkStatus       HomeworkCompletionStatus
  marksObtained        Float?
  maximumMarks         Float?
  teacherFeedback      String?
  privateTeacherNotes  String?
  evaluatedByTeacherId String
  clientRequestId      String?                   @unique
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  student            Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subject            Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  homeworkAssignment HomeworkAssignment?  @relation(fields: [homeworkAssignmentId], references: [id], onDelete: SetNull)
  evaluatedByTeacher User                 @relation("EvaluatedBy", fields: [evaluatedByTeacherId], references: [id], onDelete: Restrict)
  comments           GuardianComment[]

  @@index([studentId])
  @@index([subjectId])
  @@index([evaluationDate])
  @@index([studentId, evaluationDate])
  @@index([homeworkAssignmentId])
}

model GuardianComment {
  id                         String   @id @default(cuid())
  studentId                  String
  guardianId                 String?
  authorUserId               String
  authorRole                 Role
  relatedEvaluationId        String?
  relatedHomeworkAssignmentId String?
  parentCommentId            String?
  message                    String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  student            Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian           Guardian?           @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  relatedEvaluation  LessonEvaluation?   @relation(fields: [relatedEvaluationId], references: [id], onDelete: SetNull)
  relatedHomework    HomeworkAssignment? @relation(fields: [relatedHomeworkAssignmentId], references: [id], onDelete: SetNull)
  parentComment      GuardianComment?    @relation("CommentThread", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies            GuardianComment[]   @relation("CommentThread")

  @@index([studentId])
  @@index([guardianId])
  @@index([parentCommentId])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String
  entityType     String
  entityId       String
  action         String
  previousValues Json?
  newValues      Json?
  timestamp      DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([timestamp])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  inAppEnabled     Boolean @default(true)
  emailEnabled     Boolean @default(false)
  homeworkAssigned Boolean @default(true)
  homeworkDueSoon  Boolean @default(true)
  evaluationRecorded Boolean @default(true)
  guardianComment  Boolean @default(true)
  teacherReply     Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
