generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  OVERDUE
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  image     String?
  role      Role     @default(STUDENT)
  googleId  String?  @unique
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  uploadedNotes  Note[]          @relation("UploadedBy")
  activities     Activity[]

  @@index([role])
}

model StudentProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  studentId     String    @unique
  phone         String?
  className     String?
  institution   String?
  dateOfBirth   DateTime?
  guardianName  String?
  guardianPhone String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyLogs  StudyLog[]
  scores     Score[]
  goals      Goal[]
  notes      StudentNote[]

  @@index([className])
  @@index([isActive])
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scores Score[]
  notes  Note[]
}

model StudyLog {
  id            String   @id @default(cuid())
  studentId     String
  date          DateTime @db.Date
  studyHours    Int      @default(0)
  studyMinutes  Int      @default(0)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([date])
  @@index([studentId, date])
}

model Score {
  id            String   @id @default(cuid())
  studentId     String
  subjectId     String
  examName      String
  examDate      DateTime @db.Date
  obtainedMarks Float
  totalMarks    Float
  percentage    Float
  grade         String
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([subjectId])
  @@index([examDate])
  @@index([studentId, subjectId])
}

model Note {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileType    String
  fileSize    Int?
  subjectId   String?
  uploadedBy  String
  assignToAll Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject  Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  uploader User          @relation("UploadedBy", fields: [uploadedBy], references: [id], onDelete: Cascade)
  students StudentNote[]

  @@index([subjectId])
  @@index([uploadedBy])
  @@index([createdAt])
}

model StudentNote {
  id        String   @id @default(cuid())
  studentId String
  noteId    String
  createdAt DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  note    Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([studentId, noteId])
  @@index([noteId])
}

model Goal {
  id           String     @id @default(cuid())
  studentId    String
  title        String
  description  String?
  targetValue  Float
  currentValue Float      @default(0)
  deadline     DateTime?
  status       GoalStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([deadline])
}

model Activity {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([entityType, entityId])
}
